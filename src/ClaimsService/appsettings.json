{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ClaimsDb": "Host=localhost;Port=5432;Database=claims_db;Username=postgres;Password=postgres"
  },
  "Database": {
    "AutoCreate": true
  },
  "Auth": {
    "Mode": "Jwt",
    "Authority": "",
    "Audience": "",
    "ClientId": "",
    "RequireHttpsMetadata": true,
    "CustomerRoles": "CLIENT,CUSTOMER",
    "StaffRoles": "AGENT,REVIEWER,ADMIN,EMPLOYEE,MANAGER",
    "ManagerRoles": "ADMIN,MANAGER"
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "ClientId": "claims-service",
    "ConsumerGroupId": "claims-service",
    "ClaimSubmittedTopic": "claim.submitted.v1",
    "ClaimStatusChangedTopic": "claim.status.changed.v1",
    "ReviewRequestedTopic": "review.requested.v1",
    "RecommendationCreatedTopic": "claim.recommendation.created.v1",
    "ReviewCompletedTopic": "review.completed.v1",
    "DocumentAddedTopic": "document.added.v1",
    "EnsureTopics": true,
    "TopicPartitions": 3,
    "TopicReplicationFactor": 1
  },
  "Events": {
    "Source": "/horica/claims-service"
  },
  "AutoApproval": {
    "Enabled": true,
    "MaxAmount": 300,
    "MaxRiskScore": 0.20,
    "RequireDocuments": true
  },
  "Policies": {
    "BaseUrl": "",
    "TimeoutSeconds": 5,
    "RequireHolderMatch": true
  },
  "Swagger": {
    "Enabled": false
  }
}
